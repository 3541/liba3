package(default_visibility = ["//visibility:public"])

cc_library(
    name = "str",
    hdrs = ["str.h"],
    srcs = ["str.c"],
    deps = [
        "//a3/shim:attributes",
        "//a3/shim:memmem",
        "//a3/shim:platform",
        "//a3/shim:strncasecmp",
    ],
)

cc_library(
    name = "macro",
    hdrs = ["macro.h"],
)

cc_library(
    name = "try",
    hdrs = ["try.h"],
    deps = [":macro", "//a3/shim:likely"],
)

cc_library(
    name = "minmax",
    hdrs = ["minmax.h"],
)

cc_library(
    name = "buffer",
    hdrs = ["buffer.h"],
    srcs = ["buffer.c"],
    deps = [
        ":minmax",
        ":str",
        ":try",
        "//a3/shim:platform",
        "//a3/shim:format",
    ],
)

cc_library(
    name = "log",
    hdrs = ["log.h", "detail/log.h"],
    srcs = ["log.c"],
    deps = [
        ":macro",
        "//a3/shim:strerror",
        "//a3/shim:platform",
        "//a3/shim:attributes",
        "//a3/shim:likely",
        "//a3/shim:format",
    ],
    implementation_deps = ["//a3:str"],
)

cc_library(
    name = "unwrap",
    hdrs = ["unwrap.h"],
    deps = [
        ":log",
        "//a3/shim:likely",
    ],
)

cc_library(
    name = "ht",
    hdrs = ["ht.h"],
    deps = [
        ":unwrap",
        ":try",
        ":minmax",
        "//a3/shim:platform",
        "//a3/shim:types",
    ],
)
