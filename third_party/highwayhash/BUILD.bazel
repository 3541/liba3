load("//bazel:cc.bzl", "a3_cc_library", "a3_cc_test")

copts = select({
    "//conditions:default": [
        "-Wno-sign-conversion",
        "-Wno-implicit-int-conversion",
        "-Wno-conversion",
        "-fvisibility=default",
    ],
    "//bazel/compiler:msvc": []
})

a3_cc_library(
    name = "highwayhash",
    srcs = ["highwayhash.c"],
    hdrs = ["highwayhash.h"],
    copts = copts,
    visibility = ["//:__subpackages__"],
)

a3_cc_test(
    name = "highwayhash_test",
    size = "small",
    srcs = ["highwayhash_test.c"],
    copts = copts,
    deps = [":highwayhash"],
)
